# Copy to `.env.local` for local overrides. Never commit `.env.local`.

# Public origin used for canonical URLs, Open Graph, sitemap.xml, and robots.txt.
# Required for production deploys. Do NOT use https://authos.dev — that domain is an
# unrelated authentication product (AuthOS / drmhse/sso).
#
# Local development (default when unset):
#   http://localhost:3000
#
# Vercel (automatic when NEXT_PUBLIC_SITE_URL is unset):
#   https://<your-project>.vercel.app
#
# Custom domain example:
#   https://postgres-migration-safety-checker.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional sanitized browser analytics hook (see docs/privacy-and-telemetry.md).
# NEXT_PUBLIC_ANALYTICS_VENDOR=window-hook
# NEXT_PUBLIC_ANALYTICS_KEY=

# GitHub PR webhook (server-only — see docs/github-pr-integration.md).
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=
