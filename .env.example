# Production site URL for metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional sanitized browser analytics (disabled by default)
# NEXT_PUBLIC_ANALYTICS_VENDOR=
# NEXT_PUBLIC_ANALYTICS_KEY=

# Optional GitHub PR webhook (self-hosted only)
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=

# Browser extension build: production checker origin
# VITE_CHECKER_ORIGIN=https://your-deployed-checker.example
